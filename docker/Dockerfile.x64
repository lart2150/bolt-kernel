# x86_64 cross toolchain for the TiVo Bolt kernel (Linux 3.14.28-1.16; device built with gcc 4.8.3).
# Host side: jessie gcc 4.9.2 (3.14's scripts/ + dtc don't build with modern gcc).
# Target side: Linaro gcc 4.9.4 arm-linux-gnueabihf (3.14 has no compiler-gcc5+.h).
FROM debian/eol:jessie

# jessie is archived + its signing key expired: see Dockerfile (native) for the reasoning.
RUN set -eux; \
    printf 'deb [trusted=yes] http://archive.debian.org/debian jessie main\n' > /etc/apt/sources.list; \
    printf 'deb [trusted=yes] http://archive.debian.org/debian-security jessie/updates main\n' >> /etc/apt/sources.list; \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99noexpire; \
    apt-get update; \
    apt-get install -y --no-install-recommends gcc make libc6-dev bc xz-utils; \
    rm -rf /var/lib/apt/lists/*

# releases.linaro.org is gone; Armbian mirrors the original. sha256 cross-checked against a second
# mirror, md5 545af35e13c439cc156dc0881d976463 matches Linaro's original .asc.
# (verified with sha256sum, not ADD --checksum: the legacy builder silently ignores that flag)
ADD https://dl.armbian.com/_toolchain/gcc-linaro-4.9.4-2017.01-x86_64_arm-linux-gnueabihf.tar.xz /tmp/linaro.tar.xz
RUN echo "22914118fd963f953824b58107015c6953b5bbdccbdcf25ad9fd9a2f9f11ac07  /tmp/linaro.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/linaro.tar.xz -C /opt && mv /opt/gcc-linaro-* /opt/linaro && rm /tmp/linaro.tar.xz

ENV PATH=/opt/linaro/bin:$PATH CROSS_COMPILE=arm-linux-gnueabihf- ARCH=arm
RUN gcc --version | head -1 && ${CROSS_COMPILE}gcc --version | head -1 && ${CROSS_COMPILE}ld --version | head -1
WORKDIR /kbuild
