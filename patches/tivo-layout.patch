diff -ru a/include/linux/sched.h b/include/linux/sched.h
--- a/include/linux/sched.h	2026-10-16 21:45:01.809093627 -0500
+++ b/include/linux/sched.h	2026-10-16 21:45:01.821093463 -0500
@@ -1545,6 +1545,17 @@
