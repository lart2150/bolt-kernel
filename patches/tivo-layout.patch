+	 * fields below (ftrace/tracing/memcg/uprobes/bcache), so these sit at 0x474.
+	 */
+	unsigned long tivo_run_state;		/* 0x474 stop_runnables/restore_runnables, wake_up_state */
+	unsigned long tivo_pad_478;		/* 0x478 unidentified */
+	unsigned char tivo_cmdline_flag;	/* 0x47c proc_pid_write_cmdline, tivocrashallassert */
+	unsigned char tivo_pad_47d[3];
+	char tivo_cmdline[128];			/* 0x480 cmdline override buffer (ends at 0x500 = device sizeof) */
