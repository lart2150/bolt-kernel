CONFIG_SMP=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_LOCALVERSION=""
# CONFIG_PREEMPT is not set
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
CONFIG_CIFS=m
CONFIG_CIFS_SMB2=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
# CONFIG_KEYS is not set
# CONFIG_CIFS_UPCALL is not set
# CONFIG_CIFS_ACL is not set
# CONFIG_CIFS_DFS_UPCALL is not set
CONFIG_FUSE_FS=m
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_DNS_RESOLVER is not set
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_SPINLOCK=y
# device kernel has -fstack-protector (__stack_chk_fail/__stack_chk_guard exported); this adds
# task_struct.stack_canary -> without it cred/comm/real_parent... are shifted (+4/+8)
# CONFIG_CC_STACKPROTECTOR_NONE is not set
CONFIG_CC_STACKPROTECTOR_REGULAR=y
# DEBUG_KERNEL=y (needed for DEBUG_SPINLOCK) defaults DETECT_HUNG_TASK on -> adds task_struct.last_switch_count;
# device has no hung-task detector (no hung_task sysctls/symbols)
# CONFIG_DETECT_HUNG_TASK is not set
# device has no cgroups (/proc/self/cgroup absent, no cgroup_fork) -> CGROUPS adds task_struct.cgroups/cg_list
# CONFIG_CGROUPS is not set
# device kernel is NON-LPAE (vm_get_page_prot loads 4-byte pgprot; vm_area_struct slab = 88 bytes)
# brcmstb_defconfig has LPAE on -> pgprot/pte/phys_addr_t/dma_addr_t 64-bit -> vma etc. layouts wrong
# CONFIG_ARM_LPAE is not set
# --- game controllers (xpad: Xbox/360 USB pads, rumble via ff-memless, ring LEDs via led-class) ---
# device has input core + usb core built in, but no joystick/ff-memless/led class -> ship as modules
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_INPUT_FF_MEMLESS=m
CONFIG_INPUT_JOYDEV=m
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=m
# LEDS_TRIGGERS adds fields to led_classdev & others; device has no LED class at all
# CONFIG_LEDS_TRIGGERS is not set
# device has no dynamic debug (__dynamic_pr_debug/__dynamic_dev_dbg not exported)
# CONFIG_DYNAMIC_DEBUG is not set
# --- part 3 (2026-10-16): image diff vs device; see bolt/kernel-build-env.md "part 3"
# sk_buff layout: nfct + tc_index/tc_verd; device has no bridge-netfilter and no xfrm
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_IPV6=y
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_XFRM is not set
# CONFIG_INET6_XFRM_MODE_BEET is not set
# CONFIG_INET6_XFRM_MODE_TRANSPORT is not set
# CONFIG_INET6_XFRM_MODE_TUNNEL is not set
# request_queue layout (bdi debugfs fields, bsg fields); device has neither
# CONFIG_DEBUG_FS is not set
# CONFIG_BLK_DEV_BSG is not set
# device debug options; DEBUG_ATOMIC_SLEEP selects PREEMPT_COUNT (preempt_count inc in spin locks)
CONFIG_DEBUG_RT_MUTEXES=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_PI_LIST=y
# --- part 4 (2026-10-16): whole-kernel aligned offset diff (tools/align_offset_diff.py)
# skb flag bits: SIT selects IPV6_NDISC_NODETYPE (ndisc_nodetype:2) -> device has head_frag etc. a byte earlier
# CONFIG_IPV6_SIT is not set
# usb_bus.mon_bus/monitored (8 bytes) -> every usb_hcd field -8 on device
# CONFIG_USB_MON is not set
# sdhci_host embeds led_classdev + led_name (136 bytes); device has no LED subsystem at all
# CONFIG_NEW_LEDS is not set
